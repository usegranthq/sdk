{
  "name": "@usegrant/sdk",
  "version": "3.0.0",
  "description": "TypeSafe TypeScript SDK for accessing the UseGrant REST API",
  "license": "Apache-2.0",
  "author": "sibiraj-s",
  "homepage": "https://usegrant.dev",
  "repository": "github:usegranthq/sdk",
  "bugs": "https://github.com/usegranthq/sdk/issues",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "keywords": [
    "usegrant",
    "sdk",
    "oidc",
    "machine-to-machine",
    "oauth2"
  ],
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "default": "./dist/index.mjs"
    },
    "./schema": {
      "require": {
        "types": "./dist/schema.d.cts",
        "default": "./dist/schema.cjs"
      },
      "import": {
        "types": "./dist/schema.d.mts",
        "default": "./dist/schema.mjs"
      },
      "default": "./dist/schema.mjs"
    }
  },
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "scripts": {
    "generate": "npx -y -p typescript@6.0.3 -p @hey-api/openapi-ts@0.99.0 openapi-ts",
    "test": "vitest",
    "build": "tsdown",
    "postbuild": "publint",
    "prepare": "husky"
  },
  "dependencies": {
    "ky": "^2.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
